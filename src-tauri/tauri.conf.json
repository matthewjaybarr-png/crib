{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crib",
  "mainBinaryName": "crib",
  "version": "0.1.1",
  "identifier": "io.github.crib",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Crib",
        "width": 1300,
        "height": 850,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: tb: http://tb.localhost; frame-src tb: http://tb.localhost; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis"
    ],
    "shortDescription": "Tool book editor and machine-side viewer",
    "resources": {
      "../ui/fonts/OFL.txt": "fonts/OFL.txt",
      "../ui/fonts/README.md": "fonts/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "license": "GPL-3.0-or-later"
  }
}
